{
  "name": "@hudumika/contract",
  "version": "0.2.0",
  "description": "Generated TypeScript client, model types, MSW mock handlers, and fixture factories from HUDumika API-CONTRACT.yaml",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./mocks": "./src/mocks.ts",
    "./fixtures": "./src/fixtures.ts"
  },
  "files": [
    "src"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "scripts": {
    "generate": "orval --config ../../orval.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "publish": "npm publish"
  },
  "dependencies": {
    "msw": "^2.15.0",
    "@faker-js/faker": "^9.0.0"
  },
  "peerDependencies": {
    "msw": ">=2.0.0"
  }
}