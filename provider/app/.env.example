# Provider app local env — copy to .env for local runs.
# Every EXPO_PUBLIC_* variable is also registered in docs/ENV-VARS.md.
# No secrets in EXPO_PUBLIC_* — tokens live in expo-secure-store.

EXPO_PUBLIC_ENV=development
# Base URL only — the app appends /api (no /api/v1 in code paths).
EXPO_PUBLIC_API_URL=http://localhost:8081

# Per-module mock switchers — default ON when unset. Forced OFF in
# preview/production builds (eas.json). Never true in a shipped build.
EXPO_PUBLIC_MOCK_AUTH=true
EXPO_PUBLIC_MOCK_PROFILE=true
EXPO_PUBLIC_MOCK_BOOKINGS=true
EXPO_PUBLIC_MOCK_DISPATCH=true
EXPO_PUBLIC_MOCK_SERVICES=true
EXPO_PUBLIC_MOCK_TECHNICIANS=true
EXPO_PUBLIC_MOCK_EARNINGS=true
EXPO_PUBLIC_MOCK_NOTIFICATIONS=true
EXPO_PUBLIC_MOCK_SUPPORT=true
EXPO_PUBLIC_MOCK_CATALOG=true

# Navigation deep-link template for "Navigate to job" ({lat},{lon} placeholders).
EXPO_PUBLIC_NAV_URL=https://maps.google.com/?q={lat},{lon}
