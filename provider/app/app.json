{
  "expo": {
    "name": "Hudumika Provider",
    "slug": "provider-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hudumikaprovider",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Used to check in at job sites and prove service delivery.",
        "NSCameraUsageDescription": "Used to capture proof of service photos."
      }
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#1a5c44",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "CAMERA"
      ],
      "package": "com.hudumika.providerapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1a5c44",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 90
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#1a5c44",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "106b0574-4682-4d19-b990-7390fa19a087"
      }
    },
    "owner": "hudumika"
  }
}
