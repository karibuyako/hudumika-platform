{
  "cli": {
    "version": ">= 5.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_ENV": "development",
        "EXPO_PUBLIC_API_URL": "https://staging-api.hudumika.co.tz/api/v1",
        "EXPO_PUBLIC_MOCK_AUTH": "true",
        "EXPO_PUBLIC_MOCK_PROFILE": "true",
        "EXPO_PUBLIC_MOCK_BOOKINGS": "true",
        "EXPO_PUBLIC_MOCK_DISPATCH": "true",
        "EXPO_PUBLIC_MOCK_SERVICES": "true",
        "EXPO_PUBLIC_MOCK_TECHNICIANS": "true",
        "EXPO_PUBLIC_MOCK_EARNINGS": "true",
        "EXPO_PUBLIC_MOCK_NOTIFICATIONS": "true",
        "EXPO_PUBLIC_MOCK_SUPPORT": "true",
        "EXPO_PUBLIC_MOCK_CATALOG": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_ENV": "staging",
        "EXPO_PUBLIC_API_URL": "https://hudumika-api-production.up.railway.app/api/v1",
        "EXPO_PUBLIC_MOCK_AUTH": "false",
        "EXPO_PUBLIC_MOCK_PROFILE": "false",
        "EXPO_PUBLIC_MOCK_BOOKINGS": "false",
        "EXPO_PUBLIC_MOCK_DISPATCH": "false",
        "EXPO_PUBLIC_MOCK_SERVICES": "false",
        "EXPO_PUBLIC_MOCK_TECHNICIANS": "false",
        "EXPO_PUBLIC_MOCK_EARNINGS": "false",
        "EXPO_PUBLIC_MOCK_NOTIFICATIONS": "false",
        "EXPO_PUBLIC_MOCK_SUPPORT": "false",
            "EXPO_PUBLIC_MOCK_CATALOG": "false",
            "GRADLE_OPTS": "-Xmx3g -XX:MaxMetaspaceSize=1024m -Dorg.gradle.daemon=false",
            "NODE_OPTIONS": "--max-old-space-size=2048"
          }
        },
    "production": {
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://hudumika-api-production.up.railway.app/api/v1",
        "EXPO_PUBLIC_MOCK_AUTH": "false",
        "EXPO_PUBLIC_MOCK_PROFILE": "false",
        "EXPO_PUBLIC_MOCK_BOOKINGS": "false",
        "EXPO_PUBLIC_MOCK_DISPATCH": "false",
        "EXPO_PUBLIC_MOCK_SERVICES": "false",
        "EXPO_PUBLIC_MOCK_TECHNICIANS": "false",
        "EXPO_PUBLIC_MOCK_EARNINGS": "false",
        "EXPO_PUBLIC_MOCK_NOTIFICATIONS": "false",
        "EXPO_PUBLIC_MOCK_SUPPORT": "false",
        "EXPO_PUBLIC_MOCK_CATALOG": "false"
      }
    }
  }
}
