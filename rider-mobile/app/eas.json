{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_ENV": "development",
        "EXPO_PUBLIC_API_URL": "",
        "EXPO_PUBLIC_MOCK_AUTH": "true",
        "EXPO_PUBLIC_MOCK_JOBS": "true",
        "EXPO_PUBLIC_MOCK_EARNINGS": "true",
        "EXPO_PUBLIC_MOCK_SUPPORT": "true",
        "EXPO_PUBLIC_MOCK_SAFETY": "true",
        "EXPO_PUBLIC_MOCK_VEHICLE": "true",
        "EXPO_PUBLIC_MOCK_TRIPS": "true",
        "EXPO_PUBLIC_MOCK_LOGISTICS": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_ENV": "staging",
        "EXPO_PUBLIC_API_URL": "https://hudumika-api-production.up.railway.app",
        "EXPO_PUBLIC_MOCK_AUTH": "false",
        "EXPO_PUBLIC_MOCK_JOBS": "false",
        "EXPO_PUBLIC_MOCK_EARNINGS": "false",
        "EXPO_PUBLIC_MOCK_SUPPORT": "false",
        "EXPO_PUBLIC_MOCK_SAFETY": "false",
        "EXPO_PUBLIC_MOCK_VEHICLE": "false",
        "EXPO_PUBLIC_MOCK_TRIPS": "false",
        "EXPO_PUBLIC_MOCK_LOGISTICS": "false"
      }
    },
    "preview-mock": {
      "extends": "preview",
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_ENV": "staging",
        "EXPO_PUBLIC_API_URL": "",
        "EXPO_PUBLIC_MOCK_AUTH": "true",
        "EXPO_PUBLIC_MOCK_JOBS": "true",
        "EXPO_PUBLIC_MOCK_EARNINGS": "true",
        "EXPO_PUBLIC_MOCK_SUPPORT": "true",
        "EXPO_PUBLIC_MOCK_SAFETY": "true",
        "EXPO_PUBLIC_MOCK_VEHICLE": "true",
        "EXPO_PUBLIC_MOCK_TRIPS": "true",
        "EXPO_PUBLIC_MOCK_LOGISTICS": "true"
      }
    },
    "production": {
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://hudumika-api-production.up.railway.app",
        "EXPO_PUBLIC_MOCK_AUTH": "false",
        "EXPO_PUBLIC_MOCK_JOBS": "false",
        "EXPO_PUBLIC_MOCK_EARNINGS": "false",
        "EXPO_PUBLIC_MOCK_SUPPORT": "false",
        "EXPO_PUBLIC_MOCK_SAFETY": "false",
        "EXPO_PUBLIC_MOCK_VEHICLE": "false",
        "EXPO_PUBLIC_MOCK_TRIPS": "false",
        "EXPO_PUBLIC_MOCK_LOGISTICS": "false"
      }
    }
  }
}
