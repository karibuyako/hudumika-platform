# Rider app environment (Expo SDK 57). Copy to .env for local overrides.
# Secrets never belong here — everything is EXPO_PUBLIC_* by design.

# API base. Empty = same-origin web (MSW/mock). Live: include /api/v1.
# Dev mock gateway (deprecated for this app): http://<host>:3001
EXPO_PUBLIC_API_URL=

# Environment label (development | staging | production)
EXPO_PUBLIC_ENV=development

# Mock repository switches — default ON in dev, forced OFF in EAS preview/production.
EXPO_PUBLIC_MOCK_AUTH=true
EXPO_PUBLIC_MOCK_JOBS=true
EXPO_PUBLIC_MOCK_EARNINGS=true
EXPO_PUBLIC_MOCK_SUPPORT=true
EXPO_PUBLIC_MOCK_SAFETY=true
EXPO_PUBLIC_MOCK_VEHICLE=true
