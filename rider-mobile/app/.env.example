# Rider app environment (Expo SDK 57). Copy to .env for local overrides.
# Secrets never belong here — everything is EXPO_PUBLIC_* by design.

# API base. Empty = same-origin web (MSW/mock). Live: include /api/v1.
# Dev (EAS development): ""  → MSW/mock. Local backend: http://localhost:8080/api/v1
# Preview (staging): https://staging-api.hudumika.co.tz/api/v1
# Production: https://api.hudumika.co.tz/api/v1
# NOTE: EAS preview/production can be BUILT before DNS/TLS is ready.
# If EXPO_PUBLIC_API_URL is invalid/empty at runtime, factories auto-fallback to mocks
# (see src/repos/factories.ts). Use `preview-mock` profile until DNS is valid,
# then `eas update --channel preview --env EXPO_PUBLIC_API_URL=https://...` to switch live without rebuilding.
EXPO_PUBLIC_API_URL=

# Environment label (development | staging | production)
EXPO_PUBLIC_ENV=development

# Mock repository switches — default ON in dev, forced OFF in EAS preview/production.
EXPO_PUBLIC_MOCK_AUTH=true
EXPO_PUBLIC_MOCK_JOBS=true
EXPO_PUBLIC_MOCK_EARNINGS=true
EXPO_PUBLIC_MOCK_SUPPORT=true
EXPO_PUBLIC_MOCK_SAFETY=true
EXPO_PUBLIC_MOCK_VEHICLE=true
EXPO_PUBLIC_MOCK_TRIPS=true
EXPO_PUBLIC_MOCK_LOGISTICS=true

# Maps deep-link scheme (optional — fallback to https://maps.google.com)
# EXPO_PUBLIC_MAPS_SCHEME=geo
# EXPO_PUBLIC_MAPS_SCHEME=comgooglemaps

# Optional observability (native only)
# EXPO_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
# EXPO_PUBLIC_MSW_ENABLED=true  # force MSW in EAS dev if API_URL is set
