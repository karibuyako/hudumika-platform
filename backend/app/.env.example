# Platform runtime environment (backend/app). Every variable the API and its
# workers actually read is listed here; unset values use the code default
# documented in the comment. Secrets are empty by default — fill them in the
# deployment, never in this file.

# Core
ENV=development            # development | staging | production
PORT=8080
DATABASE_URL=postgres://hudumika:hudumika@localhost:5432/hudumika
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-in-production
OTP_DEV_CODE=123456
OTP_PAYLOAD_KEY=           # hex AES-256 key for outbox payload encryption; random per-boot when unset outside production
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
CORS_ORIGINS=*
RATE_LIMIT_PER_MIN=300     # fixed-window per-user (JWT subject) request budget on the authenticated tree

# M-Pesa (Daraja) STK push
MPESA_ENV=sandbox          # sandbox | production
MPESA_CONSUMER_KEY=        # when unset, stk_push falls back to the generic HTTP gateway (mock-gateway)
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_STK_CALLBACK_URL=    # public URL Daraja POSTs the STK callback envelope to
MPESA_WEBHOOK_SECRET=      # HMAC key verifying Daraja webhooks (falls back to PAYMENT_WEBHOOK_SECRET)

# Payment webhook verification (per-provider; PAYMENT_WEBHOOK_SECRET is the
# documented default for all providers, including cardtonic)
TIGO_WEBHOOK_SECRET=
AIRTEL_WEBHOOK_SECRET=
CARD_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_SECRET=

# SMS gateway (OTP delivery) with optional backup failover
OTP_SMS_GATEWAY_URL=
OTP_SMS_GATEWAY_API_KEY=
OTP_SMS_GATEWAY_SENDER=
OTP_SMS_GATEWAY_BACKUP_URL=
OTP_SMS_GATEWAY_BACKUP_API_KEY=
OTP_SMS_GATEWAY_BACKUP_SENDER=

# Email gateway (HTTP) and SMTP relay
EMAIL_GATEWAY_URL=
EMAIL_GATEWAY_API_KEY=
EMAIL_GATEWAY_SENDER=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=           # default 587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_SMTP_FROM=

# Push notifications
EXPO_PUSH_ACCESS_TOKEN=
EXPO_PUSH_BASE_URL=        # overrides the Expo Push send endpoint (mock-gateway in dev)

# Operations / hardening
SIMULATOR_KEY=             # staging-only customer simulator gate (x-internal-key header)
ADMIN_ALLOWED_IPS=         # comma-separated IP allow-list for /admin/* when set
OTEL_EXPORTER_OTLP_ENDPOINT= # OpenTelemetry OTLP exporter endpoint (traces/metrics)
SENTRY_DSN=                # Sentry DSN for backend error reporting (empty disables)
MOCK_API_WEBHOOK_URL=      # mock-gateway only: where /payments/fire delivers signed callbacks