# NOTE: .env files are dev-only. VITE_* vars are compiled into the client
# bundle and are public — secrets never belong here. Production config is
# injected per environment at build time (see DEPLOYMENT.md).

# Dev-only mock switch for the admin console; never set in production builds.
VITE_USE_MOCKS=true
# Live admin API base override (see DEPLOYMENT.md). Empty = same-origin gateway.
VITE_ADMIN_API_URL=
