{
  "_comment": "Push creds: APNS p8 + FCM google-services.json provisioned via 'eas credentials' (never committed). See docs/NOTIFICATIONS.md steps 2-4 and docs/DEPLOYMENT.md. Set EXPO_PUBLIC_EAS_PROJECT_ID from the EAS projectId below.",
  "cli": {
    "version": ">= 5.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_ENV": "development",
        "EXPO_PUBLIC_API_URL": "http://127.0.0.1:8080",
        "EXPO_PUBLIC_MOCK_AUTH": "false",
        "EXPO_PUBLIC_MOCK_HOME": "false",
        "EXPO_PUBLIC_MOCK_ORDERS": "false",
        "EXPO_PUBLIC_MOCK_WALLET": "false",
        "EXPO_PUBLIC_MOCK_ASSISTANT": "false"
      }
    },
    "staging": {
      "distribution": "internal",
      "channel": "staging",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_ENV": "staging",
        "EXPO_PUBLIC_API_URL": "https://staging-api.hudumika.co.tz/api/v1",
        "EXPO_PUBLIC_MOCK_AUTH": "false",
        "EXPO_PUBLIC_MOCK_HOME": "false",
        "EXPO_PUBLIC_MOCK_ORDERS": "false",
        "EXPO_PUBLIC_MOCK_WALLET": "false",
        "EXPO_PUBLIC_MOCK_ASSISTANT": "false",
        "EXPO_PUBLIC_SENTRY_DSN": ""
      }
    },
    "production": {
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://api.hudumika.co.tz/api/v1",
        "EXPO_PUBLIC_MOCK_AUTH": "false",
        "EXPO_PUBLIC_MOCK_HOME": "false",
        "EXPO_PUBLIC_MOCK_ORDERS": "false",
        "EXPO_PUBLIC_MOCK_WALLET": "false",
        "EXPO_PUBLIC_MOCK_ASSISTANT": "false",
        "EXPO_PUBLIC_SENTRY_DSN": ""
      }
    }
  }
}
