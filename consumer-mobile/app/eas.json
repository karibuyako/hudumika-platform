{
  "cli": {
    "version": ">= 5.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_ENV": "development",
        "EXPO_PUBLIC_API_URL": "https://staging-api.hudumika.co.tz/api/v1",
        "EXPO_PUBLIC_MOCK_AUTH": "false",
        "EXPO_PUBLIC_MOCK_HOME": "false",
        "EXPO_PUBLIC_MOCK_ORDERS": "false",
        "EXPO_PUBLIC_MOCK_WALLET": "false",
        "EXPO_PUBLIC_MOCK_ASSISTANT": "false"
      }
    },
    "staging": {
      "distribution": "internal",
      "channel": "staging",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_ENV": "staging",
        "EXPO_PUBLIC_API_URL": "https://staging-api.hudumika.co.tz/api/v1",
        "EXPO_PUBLIC_MOCK_AUTH": "false",
        "EXPO_PUBLIC_MOCK_HOME": "false",
        "EXPO_PUBLIC_MOCK_ORDERS": "false",
        "EXPO_PUBLIC_MOCK_WALLET": "false",
        "EXPO_PUBLIC_MOCK_ASSISTANT": "false"
      }
    },
    "production": {
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://api.hudumika.co.tz/api/v1",
        "EXPO_PUBLIC_MOCK_AUTH": "false",
        "EXPO_PUBLIC_MOCK_HOME": "false",
        "EXPO_PUBLIC_MOCK_ORDERS": "false",
        "EXPO_PUBLIC_MOCK_WALLET": "false",
        "EXPO_PUBLIC_MOCK_ASSISTANT": "false"
      }
    }
  }
}
