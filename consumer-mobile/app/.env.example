# Hudumika consumer app — environment configuration (EXPO_PUBLIC_* only, no secrets).
# Registered in docs/ENV-VARS.md — every new variable must be added there in the same PR.

# API base. Live backend INCLUDES /api/v1 (contract servers block);
# dev mock gateway is the bare host (docs/API-BASE-CONVENTION.md).
EXPO_PUBLIC_API_URL=https://staging-api.hudumika.co.tz/api/v1

# development | staging | production (drives eas.json profile behavior)
EXPO_PUBLIC_ENV=development

# Mock switches — ON by default in dev, always OFF in staging/production builds.
EXPO_PUBLIC_MOCK_AUTH=true
EXPO_PUBLIC_MOCK_HOME=true
EXPO_PUBLIC_MOCK_ORDERS=true
EXPO_PUBLIC_MOCK_WALLET=true
EXPO_PUBLIC_MOCK_ASSISTANT=true

# Feature flag — checkout coupon selector (WALLET-COUPONS.md). Default ON
# (mock-first, docs/CONTRACT-ADDITIONS.md #10): the mock honors couponId on
# order create (server-side validation + discount); a live backend that has
# not shipped the contract field ignores it, so the selector is safe either way.
EXPO_PUBLIC_FEATURE_COUPON_CHECKOUT=true

# Store/support links — JSON-ish object, never hardcoded in code (ARCHITECTURE.md).
# Placeholder shape (empty strings until the store URLs exist):
#   {"ios":"https://apps.apple.com/...","android":"https://play.google.com/store/apps/details?id=...","supportPhone":"+255...","supportEmail":"support@hudumika.co.tz","privacyUrl":"https://hudumika.co.tz/privacy","termsUrl":"https://hudumika.co.tz/terms"}
# Missing or malformed JSON falls back to empty strings (src/lib/env.ts) —
# the Settings "About & links" rows render only for configured links.
EXPO_PUBLIC_APP_LINKS={"ios":"","android":"","supportPhone":"","supportEmail":"","privacyUrl":"","termsUrl":""}
