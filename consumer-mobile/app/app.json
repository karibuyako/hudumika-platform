{
  "expo": {
    "name": "Hudumika",
    "slug": "hudumika-customer",
    "version": "0.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hudumika",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.tz.hudumika.customer",
      "buildNumber": "1",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "co.tz.hudumika.customer",
      "predictiveBackGestureEnabled": false,
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "useNextNotificationsApi": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1a5c44",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 90
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1a5c44"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Hudumika uses your camera to scan table QR codes and add photos to your bookings."
        }
      ],
      "expo-image",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "34d28d5d-0cb0-4fad-a6b3-ddab4185c088"
      }
    },
    "owner": "hudumika"
  }
}
