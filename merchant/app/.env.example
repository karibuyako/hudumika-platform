# Hudumika Merchant — environment variables (see docs/ENV-VARS.md).
# Copy to .env to override; unset vars use the defaults below.

# Mock switches — one per handler module, default ON in dev.
# Set to false to route that module to the live API.
EXPO_PUBLIC_MOCK_AUTH=true
EXPO_PUBLIC_MOCK_ORDERS=true
EXPO_PUBLIC_MOCK_CATALOG=true
EXPO_PUBLIC_MOCK_CATALOGUES=true
EXPO_PUBLIC_MOCK_MERCHANTS=true
EXPO_PUBLIC_MOCK_FINANCE=true
EXPO_PUBLIC_MOCK_BI=true
EXPO_PUBLIC_MOCK_MARKETING=true
EXPO_PUBLIC_MOCK_PROMOTIONS=true
EXPO_PUBLIC_MOCK_GROUP_BUY=true
EXPO_PUBLIC_MOCK_MESSAGING=true
EXPO_PUBLIC_MOCK_NOTIFICATIONS=true
EXPO_PUBLIC_MOCK_OPS=true
EXPO_PUBLIC_MOCK_STORE=true
EXPO_PUBLIC_MOCK_LOYALTY=true
EXPO_PUBLIC_MOCK_DEVICES=true
EXPO_PUBLIC_MOCK_CATALOGUE_EXT=true
EXPO_PUBLIC_MOCK_CHAIN=true
EXPO_PUBLIC_MOCK_SUPPLY_CHAIN=true
EXPO_PUBLIC_MOCK_WEBHOOKS=true
EXPO_PUBLIC_MOCK_TASKS=true
EXPO_PUBLIC_MOCK_STAFF_OPS=true
EXPO_PUBLIC_MOCK_REPORTS=true
EXPO_PUBLIC_MOCK_ANALYTICS_EXT=true
EXPO_PUBLIC_MOCK_PRINT_JOBS=true

# Master override — false turns off every mock module at once.
EXPO_PUBLIC_MOCK_ALL=true

# API base. Mock gateway (http://<host>:3001, dev-only) or live backend
# including /api/v1 (see docs/API-BASE-CONVENTION.md).
EXPO_PUBLIC_API_URL=

# Port for the dev mock gateway (npm run mock:gateway).
MOCK_PORT=3001

# Production gate — set in release builds only; production never loads mocks.
# EXPO_PUBLIC_ENVIRONMENT=production
